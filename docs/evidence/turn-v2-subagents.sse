data: {"tool_calls":[{"index":0,"function":{"arguments":"{\"sql\": \"SELECT conrelid::regclass AS table_name, conname, pg_get_constraintdef(oid) AS definition\\nFROM pg_constraint\\nWHERE contype = 'f' AND (conrelid::regclass::text LIKE 'rental%' OR conrelid::regclass::text LIKE 'payment%' OR confrelid::regclass::text LIKE 'rental%' OR confrelid::regclass::text LIKE 'payment%')\\nORDER BY conrelid::regclass::text, conname;\"}}"}}],"type":"model.message.delta","id":"01m19e0ax0ssnjk345d8e9pgsy","thread_id":"main"}
